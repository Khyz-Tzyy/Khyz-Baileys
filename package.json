{
    "name": "khyz-baileys",
    "version": "3.0.0",
    "description": "Modded Baileys v2 \u2014 Interactive Messages, Rich Responses, Albums, Newsletter, Business & More",
    "keywords": [
        "whatsapp",
        "whatsapp-baileys",
        "baileys",
        "whatsapp-bot",
        "interactive-messages",
        "whatsapp-web"
    ],
    "homepage": "https://github.com/Khyz-Tzyy/Khyz-Baileys",
    "repository": {
        "url": "https://github.com/Khyz-Tzyy/Khyz-Baileys"
    },
    "bugs": {
        "url": "https://github.com/Khyz-Tzyy/Khyz-Baileys/issues"
    },
    "license": "MIT",
    "author": "KhyzTzyy",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib/**/*.js",
        "lib/**/*.mjs",
        "lib/**/*.d.ts",
        "lib/**/*.json",
        "WAProto/*.js",
        "WAProto/*.d.ts",
        "WAProto/*.proto",
        "engine-requirements.js"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:all": "tsc && typedoc",
        "build:docs": "typedoc",
        "build:tsc": "tsc",
        "changelog:last": "conventional-changelog -p angular -r 2",
        "changelog:preview": "conventional-changelog -p angular -u",
        "gen:protobuf": "sh WAProto/GenerateStatics.sh",
        "lint": "eslint src --ext .js,.ts,.jsx,.tsx",
        "lint:fix": "eslint src --fix --ext .js,.ts,.jsx,.tsx",
        "prepack": "",
        "prepare": "",
        "preinstall": "node ./engine-requirements.js",
        "release": "release-it",
        "test": "jest"
    },
    "dependencies": {
        "@adiwajshing/keyed-db": "^0.2.4",
        "@hapi/boom": "^9.1.3",
        "async-mutex": "^0.5.0",
        "chalk": "^4.1.2",
        "libsignal": "^6.0.0",
        "music-metadata": "^11.12.3",
        "pino": "^9.6.0",
        "protobufjs": "^7.2.4",
        "ws": "^8.13.0",
        "whatsapp-rust-bridge": "0.5.4",
        "lru-cache": "^11.1.0",
        "p-queue": "^9.0.0",
        "fflate": "^0.8.3",
        "node-fetch": "^2.6.7",
        "cache-manager": "4.0.1",
        "libphonenumber-js": "^1.10.20",
        "lodash": "^4.17.21",
        "uuid": "^9.0.0",
        "axios": "^1.3.3",
        "futoin-hkdf": "^1.5.1",
        "@cacheable/node-cache": "^1.4.0"
    },
    "devDependencies": {
        "@adiwajshing/eslint-config": "github:adiwajshing/eslint-config",
        "@types/got": "^9.6.11",
        "@types/jest": "^27.5.1",
        "@types/node": "^16.0.0",
        "@types/ws": "^8.0.0",
        "conventional-changelog-cli": "^2.2.2",
        "eslint": "^8.0.0",
        "jest": "^27.0.6",
        "jimp": "^0.16.1",
        "link-preview-js": "^3.0.0",
        "open": "^8.4.2",
        "qrcode-terminal": "^0.12.0",
        "release-it": "^15.10.3",
        "ts-jest": "^27.0.3",
        "ts-node": "^10.8.1",
        "typedoc": "^0.24.7",
        "typescript": "^4.6.4",
        "json": "^11.0.0"
    },
    "peerDependencies": {
        "jimp": "^0.16.1",
        "link-preview-js": "^3.0.0",
        "qrcode-terminal": "^0.12.0"
    },
    "peerDependenciesMeta": {
        "jimp": {
            "optional": true
        },
        "link-preview-js": {
            "optional": true
        },
        "qrcode-terminal": {
            "optional": true
        }
    },
    "packageManager": "yarn@1.22.19",
    "engines": {
        "node": ">=20.0.0"
    },
    "exports": {
        ".": {
            "require": "./lib/index.js",
            "import": "./lib/index.mjs",
            "default": "./lib/index.js"
        }
    }
}
